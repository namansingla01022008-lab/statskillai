# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string (e.g. Neon, Supabase, Cloud SQL, or local PostgreSQL)
# Example for free cloud PostgreSQL (Neon / Supabase):
# DATABASE_URL="postgresql://neondb_owner:npg_password@ep-cool-cloud.us-east-2.aws.neon.tech/statskillai?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/statskillai"

# JWT_SECRET: Secret key for signing session tokens
JWT_SECRET="statskillai_production_secret_key_change_in_production"

# PORT: Server listener port (Default: 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
