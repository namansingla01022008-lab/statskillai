generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("learner") // learner, mentor, admin
  profileType  String?  // Student, Government Employee, Private-Sector Professional
  department   String?
  designation  String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile         LearnerProfile?
  attempts        AssessmentAttempt[]
  gapAnalysis     GapAnalysis?
  learningPath    LearningPath?
  applications    Application[]
  mentorProfile   Mentor?
  sentMessages    DirectMessage[]     @relation("UserSentMessages")
  quizzes         QuizRecord[]
  settings        AppSettings?

  @@index([email])
  @@index([role])
}

model LearnerProfile {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                  String
  profileType               String
  highestEducation          String   @default("")
  qualifications            String   @default("")
  currentRoleOrCourse       String   @default("")
  yearsOfExperience         Int      @default(0)
  organisationOrInstitution String   @default("")
  skills                    String   @default("[]") // JSON string array
  interests                 String   @default("[]") // JSON string array
  previousTrainings         String   @default("[]") // JSON array of PreviousTraining
  careerGoal                String   @default("")
  targetDomainScores        String   @default("{\"Technical\":70,\"Statistical\":70,\"Digital\":70,\"Behavioural\":70}") // JSON
  completeness              Int      @default(0)
  updatedAt                 DateTime @updatedAt
}

model AssessmentAttempt {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain       String   // Technical, Statistical, Digital, Behavioural
  date         DateTime @default(now())
  questions    String   @default("[]") // JSON QuestionRecord[]
  userAnswers  String   @default("[]") // JSON number[]
  score        Int      @default(0)
  earnedWeight Int      @default(0)
  maxWeight    Int      @default(0)
  previousScore Int?
  completed    Boolean  @default(true)

  @@index([userId, domain])
}

model QuestionRecord {
  id          String   @id @default(uuid())
  domain      String   // Technical, Statistical, Digital, Behavioural
  difficulty  String   // Easy, Medium, Hard
  question    String
  options     String   // JSON string array [4]
  correctIndex Int
  explanation String
  skillTag    String
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([domain, difficulty])
}

model GapAnalysis {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp     DateTime @default(now())
  strengths     String   @default("[]") // JSON string[]
  gaps          String   @default("[]") // JSON SkillGapItem[]
  summary       String   @default("")
  priorityOrder String   @default("[]") // JSON string[]
  domainScores  String   @default("{\"Technical\":0,\"Statistical\":0,\"Digital\":0,\"Behavioural\":0}") // JSON
  targetScores  String   @default("{\"Technical\":70,\"Statistical\":70,\"Digital\":70,\"Behavioural\":70}") // JSON
  overallScore  Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Course {
  id             String    @id @default(uuid())
  title          String
  domain         String    @default("Statistical") // Technical, Statistical, Digital, Behavioural
  provider       String    // iGOT Karmayogi | NPTEL | SWAYAM | NSSTA | MoSPI | other
  source         String    @default("SWAYAM") // SWAYAM, NPTEL, iGOT Karmayogi, NSSTA, MoSPI
  duration       String?
  level          String    @default("Intermediate") // Beginner, Intermediate, Advanced
  description    String
  topic          String    @default("Statistical Inference")
  language       String    @default("English")
  sourceUrl      String
  sourceName     String    @default("Official Portal")
  portalUrl      String    @default("")
  licenseNote    String?
  status         String    @default("unverified") // verified | unverified | broken | hidden
  lastVerifiedAt DateTime?
  skillsCovered  String    @default("[]") // JSON string[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([domain])
  @@index([source])
  @@index([status])
  @@index([topic])
  @@index([sourceUrl])
}

model Career {
  id                    String    @id @default(uuid())
  roleTitle             String
  pathway               String
  requiredSkills        String    @default("[]") // JSON string[]
  requiredQualification String
  entryRoute            String
  sourceUrl             String    @unique
  sourceName            String
  status                String    @default("unverified") // verified | unverified | broken | hidden
  lastVerifiedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([pathway])
}

model Dataset {
  id              String    @id @default(uuid())
  name            String
  publisher       String
  sourceUrl       String    @unique
  licence         String    @default("GODL-India")
  attributionText String
  lastVerifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([publisher])
}

model LearningPath {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  careerGoal      String         @default("")
  progressPercent Int            @default(0)
  isCompleted     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  steps           LearningStep[]
}

model LearningStep {
  id                  String       @id @default(uuid())
  learningPathId      String
  learningPath        LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  title               String
  domain              String       // Technical, Statistical, Digital, Behavioural
  type                String       // Course, Training Programme, Reading, Practice
  estimatedDuration   String
  source              String
  rationale           String
  status              String       @default("Not started") // Not started, In progress, Completed
  isAiSuggested       Boolean      @default(false)
  isMentorRecommended Boolean      @default(false)
  courseId            String?
  orderIndex          Int          @default(0)

  @@index([learningPathId])
}

model Opportunity {
  id              String        @id @default(uuid())
  title           String
  organisation    String
  orgId           String
  sector          String
  location        String
  type            String        // Job, Internship, Apprenticeship, Training Programme
  requiredSkills  String        @default("[]") // JSON string[]
  minDomainLevels String        @default("{\"Technical\":50,\"Statistical\":50,\"Digital\":50,\"Behavioural\":50}") // JSON
  description     String
  deadline        String
  stipendOrSalary String?
  createdAt       DateTime      @default(now())
  applications    Application[]

  @@index([type])
  @@index([sector])
}

model Application {
  id               String      @id @default(uuid())
  opportunityId    String
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityTitle String
  organisation     String
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName         String
  userEmail        String
  appliedAt        DateTime    @default(now())
  status           String      @default("Submitted") // Submitted, Under review, Shortlisted, Closed
  matchPercentage  Int         @default(50)
  notes            String?

  @@index([userId])
  @@index([opportunityId])
}

model Mentor {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  title           String
  organisation    String
  field           String
  experienceYears Int          @default(0)
  languages       String       @default("[\"English\"]") // JSON string[]
  bio             String       @default("")
  isVerified      Boolean      @default(false)
  verifiedDate    String?
  availability    String       @default("Flexible")
  rating          Float        @default(5.0)
  totalReviews    Int          @default(0)
  price           Int          @default(10)
  totalSessions   Int          @default(0)
  expertise       String       @default("[]") // JSON string[]
  avatarUrl       String?
  availableSlots  String       @default("[]") // JSON MentorAvailabilitySlot[]
  mentorships     Mentorship[]
  sessionBookings MentorshipSessionBooking[]

  @@index([userId])
}

model MentorshipSessionBooking {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  meetingId       String
  studentId       String
  studentName     String
  mentorId        String
  mentor          Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  mentorName      String
  mentorTitle     String?
  skillDomain     String   // Technical, Statistical, Digital, Behavioural
  topic           String
  date            String
  timeSlot        String
  durationMinutes Int      @default(45)
  price           Int      @default(10)
  paymentStatus   String   @default("Successful") // Pending, Successful, Failed, Refunded
  sessionStatus   String   @default("Upcoming")   // Upcoming, Live, Completed, Cancelled
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  feedback        MentorshipSessionFeedback?

  @@index([studentId])
  @@index([mentorId])
  @@index([sessionStatus])
}

model MentorshipSessionFeedback {
  id                  String   @id @default(uuid())
  bookingId           String   @unique
  booking             MentorshipSessionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sessionId           String   @unique
  mentorId            String
  studentId           String
  studentUnderstanding String
  strengths           String   @default("[]") // JSON string[]
  weaknesses          String   @default("[]") // JSON string[]
  recommendedTopics   String   @default("[]") // JSON string[]
  nextTasks           String   @default("[]") // JSON string[]
  personalMessage     String   @default("")
  rating              Int?
  review              String?
  isHelpful           Boolean?
  skillBoostPoints    Int      @default(5)
  skillBoostDomain    String   @default("Technical")
  previousScore       Int      @default(62)
  updatedScore        Int      @default(67)
  createdAt           DateTime @default(now())

  @@index([studentId])
  @@index([mentorId])
}

model Mentorship {
  id                 String          @id @default(uuid())
  mentorId           String
  mentor             Mentor          @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  mentorName         String
  mentorUserId       String
  learnerId          String
  learnerName        String
  learnerProfileType String
  goalMessage        String
  status             String          @default("Pending") // Pending, Accepted, Declined, Completed
  requestedAt        DateTime        @default(now())
  meetingSchedule    String?
  feedbackNotes      String          @default("[]") // JSON string[]
  rating             Int?
  ratingComment      String?
  messages           DirectMessage[]

  @@index([mentorUserId])
  @@index([learnerId])
}

model DirectMessage {
  id           String     @id @default(uuid())
  mentorshipId String
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderName   String
  senderRole   String     // learner, mentor, admin
  text         String
  timestamp    DateTime   @default(now())
  isRead       Boolean    @default(false)

  @@index([mentorshipId])
}

model QuizRecord {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  sourceType     String   // pdf, text
  sourceSnippet  String   @default("")
  timestamp      DateTime @default(now())
  difficulty     String   // Easy, Medium, Hard, Mixed
  questions      String   @default("[]") // JSON QuestionRecord[]
  userAnswers    String   @default("[]") // JSON number[]
  score          Int      @default(0)
  totalQuestions Int      @default(5)

  @@index([userId])
}

model Organisation {
  id          String   @id @default(uuid())
  name        String   @unique
  sector      String
  description String
  createdAt   DateTime @default(now())
}

model AppSettings {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  language     String  @default("en")
  highContrast Boolean @default(false)
  fontSize     String  @default("default")
}

model RewardRule {
  id          String   @id @default(uuid())
  eventType   String   @unique // ASSESSMENT_PASS | QUIZ_PASS | STEP_COMPLETE | PATH_COMPLETE | CERT_APPROVED | STREAK_7DAY
  label       String
  xpAmount    Int
  isActive    Boolean  @default(true)
  dailyCap    Int?
  totalCap    Int?
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RewardTransaction {
  id             String   @id @default(uuid())
  userId         String
  type           String   // EARN | DEDUCT | ADJUST | REFUND
  xpAmount       Int
  eventType      String?
  referenceId    String?
  idempotencyKey String   @unique
  description    String   @default("")
  createdAt      DateTime @default(now())
  processedVia   String   @default("DIRECT") // DIRECT | OUTBOX

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model RewardBalance {
  id            String   @id @default(uuid())
  userId        String   @unique
  totalEarned   Int      @default(0)
  totalRedeemed Int      @default(0)
  balance       Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@index([balance])
}

model RewardOutbox {
  id          String    @id @default(uuid())
  userId      String
  eventType   String
  referenceId String
  xpAmount    Int
  status      String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  retryCount  Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  processedAt DateTime?

  @@index([status, scheduledAt])
  @@index([userId])
}

model LearnerStreak {
  id                  String    @id @default(uuid())
  userId              String    @unique
  currentStreak       Int       @default(0)
  lastActivityDate    String    @default("") // YYYY-MM-DD in UTC
  longestStreak       Int       @default(0)
  totalActiveDays     Int       @default(0)
  lastStreakAwardedAt DateTime?

  @@index([userId])
}

model Certificate {
  id              String    @id @default(uuid())
  userId          String
  courseName      String
  provider        String    // NPTEL | SWAYAM | Coursera | iGOT | Other
  certId          String
  verificationUrl String
  fileKey         String?
  status          String    @default("PENDING") // PENDING | UNDER_REVIEW | APPROVED | REJECTED
  adminNote       String?
  rejectionReason String?
  verifiedAt      DateTime?
  submittedAt     DateTime  @default(now())
  xpAwarded       Boolean   @default(false)

  @@unique([userId, provider, certId])
  @@index([userId])
  @@index([status])
}

model Reward {
  id             String       @id @default(uuid())
  name           String
  brand          String
  category       String       // VOUCHER | COURSE_ACCESS | SUBSCRIPTION | OTHER
  description    String       @default("")
  xpCost         Int
  stock          Int          @default(-1) // -1 = unlimited
  isActive       Boolean      @default(true)
  imageUrl       String?
  requiresReview Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  redemptions    Redemption[]

  @@index([isActive])
  @@index([category])
}

model Redemption {
  id             String    @id @default(uuid())
  userId         String
  rewardId       String
  reward         Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  xpSpent        Int
  status         String    @default("PENDING") // PENDING | PROCESSING | SUCCESS | FAILED | CANCELLED | REFUNDED
  voucherCode    String?
  failureReason  String?
  idempotencyKey String    @unique
  refundTxId     String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([rewardId])
}

model Badge {
  id          String      @id @default(uuid())
  key         String      @unique // e.g. "FIRST_COURSE", "CERT_CHAMPION"
  name        String
  description String
  iconName    String
  xpBonus     Int         @default(0)
  tier        String      @default("BRONZE") // BRONZE | SILVER | GOLD | PLATINUM
  userBadges  UserBadge[]
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeKey String
  badge    Badge    @relation(fields: [badgeKey], references: [key], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@unique([userId, badgeKey])
  @@index([userId])
}

model RewardAuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actorRole    String
  targetUserId String?
  action       String   // CERT_APPROVE | CERT_REJECT | MANUAL_ADJUST | REWARD_CREATE | etc.
  detail       String   // JSON string with before/after and reason
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([createdAt])
}

